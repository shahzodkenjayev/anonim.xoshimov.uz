# PHP kengaytmasini yashirish (URL Rewrite)
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /
    
    # Root uchun index.php ni ko'rsatish
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} ^/$
    RewriteRule ^$ index.php [L]
    
    # .php kengaytmasini yashirish
    # Agar URL .php bilan tugamasa va fayl mavjud bo'lsa
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}.php -f
    RewriteRule ^(.*)$ $1.php [L,QSA]
    
    # Agar URL .php bilan tugasa, uni olib tashlash (ixtiyoriy)
    RewriteCond %{THE_REQUEST} \s/+(.+?)\.php[\s?] [NC]
    RewriteRule ^ /%1 [R=301,L]
</IfModule>

# .env faylini bloklash
<FilesMatch "\.env$">
    Require all denied
</FilesMatch>

# .env.* fayllarni bloklash (masalan: .env.local, .env.production)
<FilesMatch "^\.env\.">
    Require all denied
</FilesMatch>

# config/ papkasini bloklash
<IfModule mod_rewrite.c>
    RewriteRule ^config/ - [F,L]
</IfModule>

# config/ papkasidagi barcha fayllarni bloklash (DirectoryMatch ba'zi serverlarda ishlamasligi mumkin)
# Bu qoida config/.htaccess orqali amalga oshiriladi

# includes/ papkasidagi PHP fayllarni to'g'ridan-to'g'ri ochishni bloklash
<IfModule mod_rewrite.c>
    RewriteRule ^includes/.*\.php$ - [F,L]
</IfModule>

# Xavfsizlik: Sensitive fayllarni bloklash
<FilesMatch "\.(sql|log|ini|conf|bak|backup|old|tmp)$">
    Require all denied
</FilesMatch>

# Xavfsizlik: Git fayllarini bloklash
<IfModule mod_rewrite.c>
    RewriteRule ^\.git - [F,L]
    RewriteRule ^\.gitignore - [F,L]
</IfModule>

# Xavfsizlik: Composer fayllarini bloklash
<IfModule mod_rewrite.c>
    RewriteRule ^composer\.(json|lock)$ - [F,L]
</IfModule>

# Xavfsizlik: README va boshqa dokumentatsiya fayllarini bloklash (ixtiyoriy)
# <FilesMatch "^(README|CHANGELOG|LICENSE|DEPLOYMENT|ENV_SETUP|GIT_SETUP|QUICK_START|REMOTE_SETUP_GUIDE)\.(md|txt)$">
#     Order allow,deny
#     Deny from all
# </FilesMatch>

# PHP xavfsizlik sozlamalari (PHP versiyasiga qarab o'zgaradi)
# Ba'zi serverlarda ishlamasligi mumkin, shuning uchun comment qilingan
# <IfModule mod_php.c>
#     php_flag display_errors Off
#     php_flag log_errors On
# </IfModule>

# Directory listing ni o'chirish
Options -Indexes

# Default charset
AddDefaultCharset UTF-8

# MIME types
<IfModule mod_mime.c>
    AddType application/javascript js
    AddType text/css css
</IfModule>

# Cache Control - HTML va PHP fayllar uchun cache'ni o'chirish
<IfModule mod_headers.c>
    # HTML va PHP fayllar uchun cache'ni o'chirish (meta teglar yangilanishi uchun)
    <FilesMatch "\.(html|htm|php)$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </FilesMatch>
    
    # CSS va JS fayllar uchun cache (ixtiyoriy - tez yuklanish uchun)
    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "public, max-age=3600"
    </FilesMatch>
    
    # Rasmlar uchun cache
    <FilesMatch "\.(jpg|jpeg|png|gif|svg|webp)$">
        Header set Cache-Control "public, max-age=86400"
    </FilesMatch>
</IfModule>

